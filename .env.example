# Copy to .env (gitignored). Values here match docker-compose.yml defaults.

# Used by docker compose to initialise the Postgres container
POSTGRES_USER=slawatch
POSTGRES_PASSWORD=slawatch
POSTGRES_DB=slawatch
POSTGRES_PORT=5432

# Used by the pipeline (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://slawatch:slawatch@localhost:5432/slawatch

# Used by the integration tests; the test creates this database if it does not exist
SLAWATCH_TEST_DATABASE_URL=postgresql+psycopg://slawatch:slawatch@localhost:5432/slawatch_test
