      <column datatype="string" name="[Ticket ID]" role="dimension" type="nominal" />
      <column datatype="datetime" name="[Created At (UTC)]" role="dimension" type="ordinal" />
      <column datatype="string" name="[Customer ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Site ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Service ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Tier]" role="dimension" type="nominal" />
      <column datatype="string" name="[Region]" role="dimension" type="nominal" />
      <column datatype="string" name="[Service Type]" role="dimension" type="nominal" />
      <column datatype="string" name="[Assignment Group]" role="dimension" type="nominal" />
      <column datatype="string" name="[Severity]" role="dimension" type="nominal" />
      <column datatype="string" name="[Ticket Type]" role="dimension" type="nominal" />
      <column datatype="string" name="[Channel]" role="dimension" type="nominal" />
      <column datatype="string" name="[Status]" role="dimension" type="nominal" />
      <column datatype="string" name="[During Outage]" role="dimension" type="nominal" />
      <column datatype="string" name="[Outage ID]" role="dimension" type="nominal" />
      <column datatype="real" name="[SLA Target Hours]" role="measure" type="quantitative" />
      <column datatype="datetime" name="[Resolved At (UTC)]" role="dimension" type="ordinal" />
      <column datatype="real" name="[Resolution Hours]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Is Resolved]" role="measure" type="quantitative" />
      <column datatype="string" name="[SLA Outcome]" role="dimension" type="nominal" />
      <column datatype="integer" name="[Has Outcome]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Is Breached]" role="measure" type="quantitative" />
      <column datatype="real" name="[Breach Probability]" role="measure" type="quantitative" />
      <column datatype="string" name="[Risk Band]" role="dimension" type="nominal" />
      <column datatype="string" name="[Model Split]" role="dimension" type="nominal" />
      <column caption="SLA Compliance %" datatype="real" name="[SLA Compliance %]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1 - SUM([Is Breached]) / SUM([Has Outcome])" />
      </column>
      <column caption="Breach Rate %" datatype="real" name="[Breach Rate %]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Is Breached]) / SUM([Has Outcome])" />
      </column>
      <column caption="Tickets" datatype="integer" name="[Tickets]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([Ticket ID])" />
      </column>
      <column caption="Breaches" datatype="integer" name="[Breaches]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Is Breached])" />
      </column>
      <column caption="Open Tickets" datatype="integer" name="[Open Tickets]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([Status] = 'Cancelled', 0, 1 - [Is Resolved]))" />
      </column>
      <column caption="Resolved Tickets" datatype="integer" name="[Resolved Tickets]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Is Resolved])" />
      </column>
      <column caption="Median Resolution Hours" datatype="real" name="[Median Resolution Hours]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MEDIAN([Resolution Hours])" />
      </column>
      <column caption="P90 Resolution Hours" datatype="real" name="[P90 Resolution Hours]" role="measure" type="quantitative">
        <calculation class="tableau" formula="PERCENTILE([Resolution Hours], 0.9)" />
      </column>
      <column caption="High Risk Tickets" datatype="integer" name="[High Risk Tickets]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([Risk Band] = 'High', 1, 0))" />
      </column>
      <column caption="Probability Decile" datatype="integer" name="[Probability Decile]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="INT([Breach Probability] * 10) + 1" />
      </column>
      <column caption="Created Week" datatype="date" name="[Created Week]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATETRUNC('week', [Created At (UTC)])" />
      </column>
      <column caption="Created Month" datatype="date" name="[Created Month]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATETRUNC('month', [Created At (UTC)])" />
      </column>
    </datasource>
