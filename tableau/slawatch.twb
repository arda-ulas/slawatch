            <format attr="title" class="0" field="[federated.fact_ticket].[usr:Tickets:qk]" scope="rows" value="Tickets" />
            <format attr="title" class="0" field="[federated.fact_ticket].[twk:Created At (UTC):qk]" scope="cols" value="Week opened" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
