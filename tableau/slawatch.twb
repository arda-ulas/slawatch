          <strip size="160">
            <card type="pages" />
            <card type="filters" />
            <card type="marks" />
          </strip>
        </edge>
      </cards>
    </window>
    <window class="worksheet" name="Risk calibration">
      <cards>
        <edge name="left">
          <strip size="160">
            <card type="pages" />
            <card type="filters" />
            <card type="marks" />
          </strip>
        </edge>
      </cards>
    </window>
    <window class="worksheet" name="Weekly compliance">
      <cards>
        <edge name="left">
          <strip size="160">
            <card type="pages" />
            <card type="filters" />
            <card type="marks" />
          </strip>
        </edge>
      </cards>
    </window>
  </windows>
</workbook>