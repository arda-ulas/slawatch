    <worksheet name="SLA compliance heatmap">
      <layout-options>
        <title>
          <formatted-text>
            <run>SLA compliance: customer x service type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Monthly SLA compliance (synthetic)" name="federated.monthly_compliance" />
          </datasources>
          <datasource-dependencies datasource="federated.monthly_compliance">
            <column caption="Compliance %" datatype="real" name="[Compliance %]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="1 - SUM([Breached Tickets]) / SUM([Tickets With Outcome])" />
            </column>
            <column datatype="string" name="[Customer]" role="dimension" type="nominal" />
            <column datatype="date" name="[Month]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Service Type]" role="dimension" type="nominal" />
            <column datatype="integer" name="[Tickets With Outcome]" role="measure" type="quantitative" />
            <column datatype="string" name="[Tier]" role="dimension" type="nominal" />
            <column-instance column="[Customer]" derivation="None" name="[none:Customer:nk]" pivot="key" type="nominal" />
            <column-instance column="[Month]" derivation="None" name="[none:Month:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Service Type]" derivation="None" name="[none:Service Type:nk]" pivot="key" type="nominal" />
            <column-instance column="[Tier]" derivation="None" name="[none:Tier:nk]" pivot="key" type="nominal" />
            <column-instance column="[Tickets With Outcome]" derivation="Sum" name="[sum:Tickets With Outcome:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Compliance %]" derivation="User" name="[usr:Compliance %:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.monthly_compliance].[none:Month:qk]" filter-group="11" included-values="in-range">
            <min>#2024-07-01#</min>
            <max>#2026-06-01#</max>
          </filter>
          <filter class="categorical" column="[federated.monthly_compliance].[none:Tier:nk]" filter-group="12">
            <groupfilter function="level-members" level="[none:Tier:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <computed-sort column="[federated.monthly_compliance].[none:Customer:nk]" direction="ASC" using="[federated.monthly_compliance].[usr:Compliance %:qk]" />
          <slices>
            <column>[federated.monthly_compliance].[none:Month:qk]</column>
            <column>[federated.monthly_compliance].[none:Tier:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="mark">
            <encoding attr="color" center="0.85" field="[federated.monthly_compliance].[usr:Compliance %:qk]" max="1.0" min="0.7" type="custom-interpolated">
              <color-palette custom="true" name="" type="ordered-diverging">
                <color>#c0392b</color>
                <color>#f4d35e</color>
                <color>#2e7d32</color>
              </color-palette>
            </encoding>
          </style-rule>
          <style-rule element="label">
            <format attr="text-format" field="[federated.monthly_compliance].[usr:Compliance %:qk]" value="p0%" />
          </style-rule>
          <style-rule element="cell">
            <format attr="font-size" value="7" />
          </style-rule>
          <style-rule element="header">
            <format attr="font-size" value="7" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[federated.monthly_compliance].[usr:Compliance %:qk]" />
              <text column="[federated.monthly_compliance].[usr:Compliance %:qk]" />
              <tooltip column="[federated.monthly_compliance].[sum:Tickets With Outcome:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.monthly_compliance].[none:Customer:nk]</rows>
        <cols>[federated.monthly_compliance].[none:Service Type:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Backlog ageing">
      <layout-options>
        <title>
          <formatted-text>
            <run>Open backlog by age band (1st of month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Backlog ageing (synthetic)" name="federated.backlog_ageing" />
          </datasources>
          <datasource-dependencies datasource="federated.backlog_ageing">
            <column datatype="string" name="[Age Band]" role="dimension" type="nominal" />
            <column datatype="integer" name="[Open Tickets]" role="measure" type="quantitative" />
            <column caption="Past Due Share" datatype="real" name="[Past Due Share]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([Past Due Tickets]) / SUM([Open Tickets])" />
            </column>
            <column datatype="integer" name="[Past Due Tickets]" role="measure" type="quantitative" />
            <column datatype="string" name="[Service Type]" role="dimension" type="nominal" />
            <column datatype="date" name="[Snapshot Date]" role="dimension" type="ordinal" />
            <column-instance column="[Age Band]" derivation="None" name="[none:Age Band:nk]" pivot="key" type="nominal" />
            <column-instance column="[Service Type]" derivation="None" name="[none:Service Type:nk]" pivot="key" type="nominal" />
            <column-instance column="[Open Tickets]" derivation="Sum" name="[sum:Open Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Past Due Tickets]" derivation="Sum" name="[sum:Past Due Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Snapshot Date]" derivation="Month-Trunc" name="[tmn:Snapshot Date:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Past Due Share]" derivation="User" name="[usr:Past Due Share:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.backlog_ageing].[none:Service Type:nk]" filter-group="21">
            <groupfilter function="level-members" level="[none:Service Type:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <manual-sort column="[federated.backlog_ageing].[none:Age Band:nk]" direction="ASC">
            <dictionary>
              <bucket>"0-24h"</bucket>
              <bucket>"1-3d"</bucket>
              <bucket>"3-7d"</bucket>
              <bucket>"7-30d"</bucket>
              <bucket>"30d+"</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.backlog_ageing].[none:Service Type:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.backlog_ageing].[sum:Open Tickets:qk]" scope="rows" value="Open tickets" />
            <format attr="title" class="0" field="[federated.backlog_ageing].[tmn:Snapshot Date:qk]" scope="cols" value="Snapshot" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Area" />
            <encodings>
              <color column="[federated.backlog_ageing].[none:Age Band:nk]" />
              <tooltip column="[federated.backlog_ageing].[sum:Past Due Tickets:qk]" />
              <tooltip column="[federated.backlog_ageing].[usr:Past Due Share:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.backlog_ageing].[sum:Open Tickets:qk]</rows>
        <cols>[federated.backlog_ageing].[tmn:Snapshot Date:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Risk calibration">
      <layout-options>
        <title>
          <formatted-text>
            <run>Predicted vs observed breach rate by decile (test months)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Risk calibration deciles (synthetic)" name="federated.risk_deciles" />
          </datasources>
          <datasource-dependencies datasource="federated.risk_deciles">
            <column datatype="integer" name="[Decile]" role="dimension" type="ordinal" />
            <column datatype="real" name="[Mean Predicted]" role="measure" type="quantitative" default-format="p0.0%" />
            <column datatype="real" name="[Observed Breach Rate]" role="measure" type="quantitative" default-format="p0.0%" />
            <column datatype="integer" name="[Tickets]" role="measure" type="quantitative" />
            <column-instance column="[Decile]" derivation="None" name="[none:Decile:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Mean Predicted]" derivation="Sum" name="[sum:Mean Predicted:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Observed Breach Rate]" derivation="Sum" name="[sum:Observed Breach Rate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Tickets]" derivation="Sum" name="[sum:Tickets:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.risk_deciles].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.risk_deciles].[sum:Mean Predicted:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.risk_deciles].[sum:Observed Breach Rate:qk]&quot;" />
            </groupfilter>
          </filter>
          <manual-sort column="[federated.risk_deciles].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[federated.risk_deciles].[sum:Mean Predicted:qk]"</bucket>
              <bucket>"[federated.risk_deciles].[sum:Observed Breach Rate:qk]"</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.risk_deciles].[:Measure Names]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.risk_deciles].[Multiple Values]" scope="rows" value="Breach rate" />
            <format attr="title" class="0" field="[federated.risk_deciles].[none:Decile:ok]" scope="cols" value="Predicted-probability decile" />
          </style-rule>
          <style-rule element="label">
            <format attr="text-format" field="[federated.risk_deciles].[Multiple Values]" value="p0%" />
            <format attr="display" field="[federated.risk_deciles].[:Measure Names]" value="false" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.risk_deciles].[:Measure Names]" />
              <tooltip column="[federated.risk_deciles].[sum:Tickets:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.risk_deciles].[Multiple Values]</rows>
        <cols>([federated.risk_deciles].[none:Decile:ok] / [federated.risk_deciles].[:Measure Names])</cols>
      </table>
    </worksheet>
    <worksheet name="Site map">
      <layout-options>
        <title>
          <formatted-text>
            <run>Ticket volume and breach rate by city</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Tickets (synthetic)" name="federated.fact_ticket" />
          </datasources>
          <mapsources>
            <mapsource name="Tableau" />
          </mapsources>
          <datasource-dependencies datasource="federated.fact_ticket">
            <column caption="Breach Rate %" datatype="real" name="[Breach Rate %]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([Is Breached]) / SUM([Has Outcome])" />
            </column>
            <column datatype="string" name="[City]" role="dimension" type="nominal" semantic-role="[City].[Name]" />
            <column datatype="datetime" name="[Created At (UTC)]" role="dimension" type="ordinal" />
            <column caption="High Risk Tickets" datatype="integer" name="[High Risk Tickets]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="SUM(IIF([Risk Band] = 'High', 1, 0))" />
            </column>
            <column datatype="real" name="[Latitude]" role="measure" type="quantitative" semantic-role="[Geographical].[Latitude]" />
            <column datatype="real" name="[Longitude]" role="measure" type="quantitative" semantic-role="[Geographical].[Longitude]" />
            <column datatype="string" name="[Province Name]" role="dimension" type="nominal" semantic-role="[State].[Name]" />
            <column datatype="string" name="[Region]" role="dimension" type="nominal" />
            <column datatype="string" name="[Service Type]" role="dimension" type="nominal" />
            <column caption="Tickets" datatype="integer" name="[Tickets]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="COUNTD([Ticket ID])" />
            </column>
            <column datatype="string" name="[Tier]" role="dimension" type="nominal" />
            <column-instance column="[Latitude]" derivation="Avg" name="[avg:Latitude:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Longitude]" derivation="Avg" name="[avg:Longitude:qk]" pivot="key" type="quantitative" />
            <column-instance column="[City]" derivation="None" name="[none:City:nk]" pivot="key" type="nominal" />
            <column-instance column="[Created At (UTC)]" derivation="None" name="[none:Created At (UTC):qk]" pivot="key" type="quantitative" />
            <column-instance column="[Province Name]" derivation="None" name="[none:Province Name:nk]" pivot="key" type="nominal" />
            <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
            <column-instance column="[Service Type]" derivation="None" name="[none:Service Type:nk]" pivot="key" type="nominal" />
            <column-instance column="[Tier]" derivation="None" name="[none:Tier:nk]" pivot="key" type="nominal" />
            <column-instance column="[Breach Rate %]" derivation="User" name="[usr:Breach Rate %:qk]" pivot="key" type="quantitative" />
            <column-instance column="[High Risk Tickets]" derivation="User" name="[usr:High Risk Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Tickets]" derivation="User" name="[usr:Tickets:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.fact_ticket].[none:Created At (UTC):qk]" filter-group="1" included-values="in-range">
            <min>#2024-07-01 01:16:54#</min>
            <max>#2026-06-30 23:51:27#</max>
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Tier:nk]" filter-group="2">
            <groupfilter function="level-members" level="[none:Tier:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Service Type:nk]" filter-group="3">
            <groupfilter function="level-members" level="[none:Service Type:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Region:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:Region:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.fact_ticket].[none:Created At (UTC):qk]</column>
            <column>[federated.fact_ticket].[none:Tier:nk]</column>
            <column>[federated.fact_ticket].[none:Service Type:nk]</column>
            <column>[federated.fact_ticket].[none:Region:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="mark">
            <encoding attr="color" center="0.15" field="[federated.fact_ticket].[usr:Breach Rate %:qk]" max="0.3" min="0.05" type="custom-interpolated">
              <color-palette custom="true" name="" type="ordered-diverging">
                <color>#2e7d32</color>
                <color>#f4d35e</color>
                <color>#c0392b</color>
              </color-palette>
            </encoding>
          </style-rule>
          <style-rule element="map">
            <format attr="washout" value="0.3" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[federated.fact_ticket].[usr:Breach Rate %:qk]" />
              <size column="[federated.fact_ticket].[usr:Tickets:qk]" />
              <lod column="[federated.fact_ticket].[none:City:nk]" />
              <lod column="[federated.fact_ticket].[none:Province Name:nk]" />
              <tooltip column="[federated.fact_ticket].[usr:High Risk Tickets:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-transparency" value="200" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.fact_ticket].[avg:Latitude:qk]</rows>
        <cols>[federated.fact_ticket].[avg:Longitude:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Customer drill-down">
      <layout-options>
        <title>
          <formatted-text>
            <run>Customers ranked by SLA breaches</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Tickets (synthetic)" name="federated.fact_ticket" />
          </datasources>
          <datasource-dependencies datasource="federated.fact_ticket">
            <column caption="Breaches" datatype="integer" name="[Breaches]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="SUM([Is Breached])" />
            </column>
            <column datatype="datetime" name="[Created At (UTC)]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Customer]" role="dimension" type="nominal" />
            <column caption="High Risk Tickets" datatype="integer" name="[High Risk Tickets]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="SUM(IIF([Risk Band] = 'High', 1, 0))" />
            </column>
            <column caption="Median Resolution Hours" datatype="real" name="[Median Resolution Hours]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="MEDIAN([Resolution Hours])" />
            </column>
            <column caption="Open Tickets" datatype="integer" name="[Open Tickets]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="SUM(IIF([Status] = 'Cancelled', 0, 1 - [Is Resolved]))" />
            </column>
            <column datatype="string" name="[Region]" role="dimension" type="nominal" />
            <column datatype="string" name="[Service Type]" role="dimension" type="nominal" />
            <column caption="SLA Compliance %" datatype="real" name="[SLA Compliance %]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="1 - SUM([Is Breached]) / SUM([Has Outcome])" />
            </column>
            <column caption="Tickets" datatype="integer" name="[Tickets]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="COUNTD([Ticket ID])" />
            </column>
            <column datatype="string" name="[Tier]" role="dimension" type="nominal" />
            <column-instance column="[Created At (UTC)]" derivation="None" name="[none:Created At (UTC):qk]" pivot="key" type="quantitative" />
            <column-instance column="[Customer]" derivation="None" name="[none:Customer:nk]" pivot="key" type="nominal" />
            <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
            <column-instance column="[Service Type]" derivation="None" name="[none:Service Type:nk]" pivot="key" type="nominal" />
            <column-instance column="[Tier]" derivation="None" name="[none:Tier:nk]" pivot="key" type="nominal" />
            <column-instance column="[Breaches]" derivation="User" name="[usr:Breaches:qk]" pivot="key" type="quantitative" />
            <column-instance column="[High Risk Tickets]" derivation="User" name="[usr:High Risk Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Median Resolution Hours]" derivation="User" name="[usr:Median Resolution Hours:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Open Tickets]" derivation="User" name="[usr:Open Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[SLA Compliance %]" derivation="User" name="[usr:SLA Compliance %:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Tickets]" derivation="User" name="[usr:Tickets:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.fact_ticket].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:Tickets:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:SLA Compliance \%:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:Breaches:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:Open Tickets:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:High Risk Tickets:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[federated.fact_ticket].[usr:Median Resolution Hours:qk]&quot;" />
            </groupfilter>
          </filter>
          <manual-sort column="[federated.fact_ticket].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[federated.fact_ticket].[usr:Tickets:qk]"</bucket>
              <bucket>"[federated.fact_ticket].[usr:SLA Compliance \%:qk]"</bucket>
              <bucket>"[federated.fact_ticket].[usr:Breaches:qk]"</bucket>
              <bucket>"[federated.fact_ticket].[usr:Open Tickets:qk]"</bucket>
              <bucket>"[federated.fact_ticket].[usr:High Risk Tickets:qk]"</bucket>
              <bucket>"[federated.fact_ticket].[usr:Median Resolution Hours:qk]"</bucket>
            </dictionary>
          </manual-sort>
          <filter class="quantitative" column="[federated.fact_ticket].[none:Created At (UTC):qk]" filter-group="1" included-values="in-range">
            <min>#2024-07-01 01:16:54#</min>
            <max>#2026-06-30 23:51:27#</max>
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Tier:nk]" filter-group="2">
            <groupfilter function="level-members" level="[none:Tier:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Service Type:nk]" filter-group="3">
            <groupfilter function="level-members" level="[none:Service Type:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.fact_ticket].[none:Region:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:Region:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <computed-sort column="[federated.fact_ticket].[none:Customer:nk]" direction="DESC" using="[federated.fact_ticket].[usr:Breaches:qk]" />
          <slices>
            <column>[federated.fact_ticket].[:Measure Names]</column>
            <column>[federated.fact_ticket].[none:Created At (UTC):qk]</column>
            <column>[federated.fact_ticket].[none:Tier:nk]</column>
            <column>[federated.fact_ticket].[none:Service Type:nk]</column>
            <column>[federated.fact_ticket].[none:Region:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-align" value="right" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="false" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <encodings>
              <text column="[federated.fact_ticket].[Multiple Values]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.fact_ticket].[none:Customer:nk] / [federated.fact_ticket].[none:Tier:nk])</rows>
        <cols>[federated.fact_ticket].[:Measure Names]</cols>
        <tooltip-style tooltip-mode="none" />
      </table>
    </worksheet>
    <worksheet name="Weekly compliance">
      <layout-options>
        <title>
          <formatted-text>
            <run>Weekly SLA compliance, resolved tickets</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Weekly KPI (synthetic)" name="federated.weekly_kpi" />
          </datasources>
          <datasource-dependencies datasource="federated.weekly_kpi">
            <column datatype="integer" name="[Breached Tickets]" role="measure" type="quantitative" />
            <column caption="Compliance %" datatype="real" name="[Compliance %]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="1 - SUM([Breached Tickets]) / SUM([Tickets Resolved])" />
            </column>
            <column datatype="integer" name="[Tickets Resolved]" role="measure" type="quantitative" />
            <column datatype="date" name="[Week Ending]" role="dimension" type="ordinal" />
            <column-instance column="[Breached Tickets]" derivation="Sum" name="[sum:Breached Tickets:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Tickets Resolved]" derivation="Sum" name="[sum:Tickets Resolved:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Week Ending]" derivation="Week-Trunc" name="[twk:Week Ending:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Compliance %]" derivation="User" name="[usr:Compliance %:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.weekly_kpi].[usr:Compliance %:qk]" scope="rows" value="SLA compliance" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <tooltip column="[federated.weekly_kpi].[sum:Tickets Resolved:qk]" />
              <tooltip column="[federated.weekly_kpi].[sum:Breached Tickets:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#1f4e78" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.weekly_kpi].[usr:Compliance %:qk]</rows>
        <cols>[federated.weekly_kpi].[twk:Week Ending:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="slawatch: enterprise service-desk SLA risk (synthetic data)">
      <layout-options>
        <title>
          <formatted-text>
            <run>slawatch: enterprise service-desk SLA risk (synthetic data)</run>
          </formatted-text>
        </title>
      </layout-options>
